{
  "name": "design-system-ai-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A rules-driven design system prototype: token methodology, foundations, three components, Storybook docs.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "contrast": "node scripts/contrast.mjs",
    "axe": "node scripts/axe.mjs",
    "generate:ramps": "node scripts/generate-ramps.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "check": "npm run lint:tokens && npm run contrast && npm run build-storybook && npm run axe",
    "generate:docs": "node scripts/component-tokens.mjs",
    "prebuild-storybook": "node scripts/component-tokens.mjs",
    "prestorybook": "node scripts/component-tokens.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-docs": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^8.6.19",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}